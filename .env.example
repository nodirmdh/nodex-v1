NODE_ENV=development
APP_ENV=local
API_PORT=4000
CLIENT_MINI_APP_PORT=3000
DRIVER_MINI_APP_PORT=3001
ADMIN_WEB_PORT=3002
DATABASE_URL=postgresql://nodex:nodex@localhost:15432/nodex?schema=public
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=nodex-local
S3_ACCESS_KEY_ID=nodex
S3_SECRET_ACCESS_KEY=nodex-secret
JWT_ISSUER=nodex-local
JWT_AUDIENCE=nodex
JWT_SECRET=replace-with-local-secret
TELEGRAM_CLIENT_BOT_TOKEN=replace-with-client-bot-token
TELEGRAM_DRIVER_BOT_TOKEN=replace-with-driver-bot-token
TELEGRAM_SUPPORT_BOT_TOKEN=replace-with-support-bot-token
AUTH_ACCESS_TOKEN_SECRET=replace-with-access-token-secret
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_INIT_DATA_MAX_AGE=86400
AUTH_MOCK_ENABLED=true
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
TERMS_VERSION=0.1-local
PRIVACY_VERSION=0.1-local
ADMIN_TELEGRAM_USER_IDS=900000001
SUPER_ADMIN_TELEGRAM_ID=
