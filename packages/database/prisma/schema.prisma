model ChatMessage {
  id               String               @id @default(cuid())
  conversationId   String
  senderUserId     String?
  type             ChatMessageType      @default(TEXT)
  status           ChatMessageStatus    @default(SENT)
  text             String?
  locationLat      Decimal?             @db.Decimal(9, 6)
  locationLng      Decimal?             @db.Decimal(9, 6)
  locationLabel    String?
  replyToMessageId String?
  clientMessageId  String?
  sentAt           DateTime             @default(now())
  editedAt         DateTime?
  deletedAt        DateTime?
  moderationStatus ModerationStatus     @default(CLEAN)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  conversation     Conversation         @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender           User?                @relation("ChatMessageSender", fields: [senderUserId], references: [id], onDelete: SetNull)
  replyTo          ChatMessage?         @relation("ChatMessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies          ChatMessage[]        @relation("ChatMessageReplies")
  receipts         ChatMessageReceipt[]
  attachments      MessageAttachment[]
  reports          MessageReport[]

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, sentAt])
  @@index([senderUserId, sentAt])
}

model ChatMessageReceipt {
  id              String               @id @default(cuid())
  messageId       String
  recipientUserId String
