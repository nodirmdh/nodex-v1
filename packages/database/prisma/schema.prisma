  id               String      @id @default(cuid())
  messageId        String
  fileObjectId     String?
  type             String      @default("CHAT_ATTACHMENT")
  originalFileName String
  mimeType         String
  sizeBytes        Int
  checksum         String
  status           String      @default("UPLOADED")
  createdAt        DateTime    @default(now())
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileObject       FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([fileObjectId])
}

model MessageReport {
  id             String       @id @default(cuid())
  conversationId String
  messageId      String
  reporterUserId String
  reason         String
  status         String       @default("OPEN")
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  message        ChatMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reporter       User         @relation("MessageReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([status, createdAt])
}

model Notification {
  id               String                 @id @default(cuid())
  recipientUserId  String
  type             NotificationType
  title            String
  body             String
  entityType       String?
  entityId         String?
  deepLink         String?
  status           NotificationStatus     @default(UNREAD)
  createdAt        DateTime               @default(now())
  readAt           DateTime?
  archivedAt       DateTime?
  deduplicationKey String                 @unique
  templateVersion  String                 @default("phase9-v1")
  payloadJson      Json?
  recipient        User                   @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  deliveries       NotificationDelivery[]

  @@index([recipientUserId, status, createdAt])
  @@index([type, createdAt])
  @@index([entityType, entityId])
}

model NotificationDelivery {
  id                String                     @id @default(cuid())
  notificationId    String
  recipientUserId   String
  channel           NotificationChannel
  status            NotificationDeliveryStatus @default(PENDING)
  attemptCount      Int                        @default(0)
  lastAttemptAt     DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  errorCode         String?
  providerMessageId String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  notification      Notification               @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  recipient         User                       @relation("NotificationDeliveryRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@unique([notificationId, channel])
  @@index([status, channel, lastAttemptAt])
}

model NotificationTemplate {
  id        String              @id @default(cuid())
  type      NotificationType
  channel   NotificationChannel
  version   String              @default("phase9-v1")
  title     String
  body      String
  isActive  Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([type, channel, version])
}

model SupportTicket {
  id               String                     @id @default(cuid())
  requesterUserId  String
  type             SupportTicketType
  subject          String
  description      String
  status           SupportTicketStatus        @default(NEW)
  priority         SupportPriority            @default(NORMAL)
  bookingId        String?
  tripId           String?
  parcelOrderId    String?
  driverId         String?
  assignedToUserId String?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaDueAt         DateTime?
  retentionUntil   DateTime?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  version          Int                        @default(1)
  requester        User                       @relation("SupportTicketRequester", fields: [requesterUserId], references: [id], onDelete: Restrict)
  assignedTo       User?                      @relation("SupportTicketAssignee", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  booking          Booking?                   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  trip             Trip?                      @relation(fields: [tripId], references: [id], onDelete: SetNull)
  parcelOrder      ParcelOrder?               @relation(fields: [parcelOrderId], references: [id], onDelete: SetNull)
  participants     SupportTicketParticipant[]
  messages         TicketMessage[]
  attachments      TicketAttachment[]
  internalNotes    TicketInternalNote[]
  assignments      TicketAssignment[]
  statusEvents     TicketStatusEvent[]

  @@index([requesterUserId, status, updatedAt])
  @@index([status, priority, slaDueAt])
  @@index([assignedToUserId, status])
}

model SupportTicketParticipant {
  ticketId String
  userId   String
  role     String
  joinedAt DateTime      @default(now())
  leftAt   DateTime?
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ticketId, userId])
  @@index([userId])
}

model TicketMessage {
  id           String             @id @default(cuid())
  ticketId     String
  senderUserId String
  text         String
  createdAt    DateTime           @default(now())
  editedAt     DateTime?
  deletedAt    DateTime?
  ticket       SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender       User               @relation("TicketMessageSender", fields: [senderUserId], references: [id], onDelete: Restrict)
  attachments  TicketAttachment[]

  @@index([ticketId, createdAt])
}

model TicketAttachment {
  id               String         @id @default(cuid())
  ticketId         String
  messageId        String?
  fileObjectId     String?
  originalFileName String
  mimeType         String
  sizeBytes        Int
  checksum         String
  status           String         @default("UPLOADED")
  createdAt        DateTime       @default(now())
  ticket           SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message          TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  fileObject       FileObject?    @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([messageId])
}

model TicketInternalNote {
  id           String        @id @default(cuid())
  ticketId     String
  authorUserId String
  text         String
  createdAt    DateTime      @default(now())
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author       User          @relation("TicketInternalNoteAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId, createdAt])
}

model TicketAssignment {
  id               String        @id @default(cuid())
  ticketId         String
  assigneeUserId   String?
  assignedByUserId String?
  reason           String?
  createdAt        DateTime      @default(now())
  ticket           SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignee         User?         @relation("TicketAssignmentAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assignedBy       User?         @relation("TicketAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([assigneeUserId])
}

model TicketStatusEvent {
  id          String               @id @default(cuid())
  ticketId    String
  actorUserId String?
  fromStatus  SupportTicketStatus?
  toStatus    SupportTicketStatus
  reason      String?
  metadata    Json?
  createdAt   DateTime             @default(now())
  ticket      SupportTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor       User?                @relation("TicketStatusEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
  @@index([toStatus, createdAt])
}

model SupportSlaPolicy {
  id                   String          @id @default(cuid())
  priority             SupportPriority @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
  isActive             Boolean         @default(true)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}

model CommunicationTimelineEvent {
  id             String        @id @default(cuid())
  conversationId String?
  ticketId       String?
  actorUserId    String?
  type           String
  payload        Json?
  createdAt      DateTime      @default(now())
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  actor          User?         @relation("CommunicationTimelineActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([ticketId, createdAt])
  @@index([type, createdAt])
}

model BoardingCode {
  id            String            @id @default(cuid())
  bookingId     String
  codeHash      String
  codeLength    Int               @default(6)
  status        String            @default("ACTIVE")
  expiresAt     DateTime
  attemptsCount Int               @default(0)
  maxAttempts   Int               @default(5)
  lockedAt      DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  booking       Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  attempts      BoardingAttempt[]

  @@index([bookingId, status, expiresAt])
}

model BoardingAttempt {
  id             String       @id @default(cuid())
  boardingCodeId String
  actorUserId    String?
  success        Boolean      @default(false)
  reason         String?
  createdAt      DateTime     @default(now())
  boardingCode   BoardingCode @relation(fields: [boardingCodeId], references: [id], onDelete: Cascade)
  actor          User?        @relation("BoardingAttemptActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([boardingCodeId, createdAt])
  @@index([actorUserId, createdAt])
}

model TripOperationEvent {
  id          String   @id @default(cuid())
  tripId      String
  actorUserId String?
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?    @relation("TripOperationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([type, createdAt])
}

model TripStatusTransition {
  id          String     @id @default(cuid())
  tripId      String
  actorUserId String?
  fromStatus  TripStatus
  toStatus    TripStatus
  reason      String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?      @relation("TripStatusTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([toStatus, createdAt])
}

model BookingOperationEvent {
  id          String   @id @default(cuid())
  bookingId   String
  actorUserId String?
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?    @relation("BookingOperationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model NoShowRecord {
  id          String   @id @default(cuid())
  tripId      String
  bookingId   String?
  actorUserId String?
  actorRole   String
  type        String
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?    @relation("NoShowRecordActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model TripCancellation {
  id          String   @id @default(cuid())
  tripId      String
  actorUserId String?
  actorRole   String
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?    @relation("TripCancellationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
}

model TripCompletionSummary {
  id                 String   @id @default(cuid())
  tripId             String   @unique
  completedByUserId  String?
  completedAt        DateTime @default(now())
  boardedCount       Int      @default(0)
  noShowClientCount  Int      @default(0)
  cancelledCount     Int      @default(0)
  totalBookingsCount Int      @default(0)
  notes              String?
  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  completedBy        User?    @relation("TripCompletionSummaryActor", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([completedAt])
}
