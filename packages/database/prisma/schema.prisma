  destinationCity    City?     @relation("DestinationCitySearchEvents", fields: [destinationCityId], references: [id], onDelete: SetNull)
  trip               Trip?     @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([originCityId, destinationCityId, createdAt])
  @@index([tripId, createdAt])
  @@index([userId, createdAt])
}

model TripStop {
