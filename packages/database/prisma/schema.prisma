generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum AppContext {
  CLIENT_APP
  DRIVER_APP
  ADMIN_WEB
  LOCAL_MOCK
}

enum UserTheme {
  SYSTEM
  LIGHT
  DARK
  TELEGRAM
}

enum DriverOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  BASIC_COMPLETED
}

enum DriverVerificationStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum DriverVerificationApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  WITHDRAWN
  SUSPENDED
}

enum DriverVerificationDocumentType {
  IDENTITY_FRONT
  IDENTITY_BACK
  DRIVER_LICENSE_FRONT
  DRIVER_LICENSE_BACK
  VEHICLE_REGISTRATION_FRONT
  VEHICLE_REGISTRATION_BACK
  DRIVER_SELFIE
  DRIVER_WITH_LICENSE_SELFIE
  VEHICLE_FRONT
  VEHICLE_REAR
  VEHICLE_LEFT
  VEHICLE_RIGHT
  VEHICLE_INTERIOR
}

enum DriverVerificationDocumentStatus {
  UPLOADED
  ACCEPTED
  REJECTED
  REPLACED
  DELETED
}

enum DriverVerificationReviewAction {
  START_REVIEW
  APPROVE
  REJECT
  REQUEST_CHANGES
  SUSPEND
  RESTORE
}

enum DriverVerificationReasonCode {
  DOCUMENT_UNREADABLE
  DOCUMENT_EXPIRED
  DOCUMENT_MISMATCH
  SELFIE_MISMATCH
  MISSING_DOCUMENT
  INVALID_LICENSE_CATEGORY
  INVALID_VEHICLE_DATA
  VEHICLE_PHOTO_INCOMPLETE
  DUPLICATE_DRIVER
  FRAUD_SUSPECTED
  OTHER
}

enum VehicleStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum VehicleDocumentType {
  REGISTRATION_CERTIFICATE
  INSURANCE
  TECHNICAL_INSPECTION
  OWNERSHIP_OR_USAGE_PROOF
  OTHER
}

enum VehiclePhotoType {
  FRONT
  REAR
  LEFT_SIDE
  RIGHT_SIDE
  INTERIOR_FRONT
  INTERIOR_REAR
  PLATE
  OTHER
}

enum VehicleAssetStatus {
  UPLOADED
  ACCEPTED
  REJECTED
  REPLACED
  DELETED
}

enum VehicleModerationAction {
  START_REVIEW
  APPROVE
  REJECT
  REQUEST_CHANGES
  SUSPEND
  RESTORE
}

enum VehicleModerationReasonCode {
  DOCUMENT_UNREADABLE
  DOCUMENT_EXPIRED
  DOCUMENT_MISMATCH
  PHOTO_INCOMPLETE
  PLATE_MISMATCH
  INVALID_VEHICLE_DATA
  DUPLICATE_PLATE
  SAFETY_CONCERN
  OTHER
}

enum TripStatus {
  DRAFT
  PUBLISHED
  BOOKING_OPEN
  FULL
  UNPUBLISHED
  BLOCKED
  BOARDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  EXPIRED
}

enum PickupPointType {
  CITY_CENTER
  BUS_STATION
  RAILWAY_STATION
  AIRPORT
  CUSTOM
}

enum TripStopType {
  ORIGIN
  INTERMEDIATE
  DESTINATION
}

enum SeatStatus {
  AVAILABLE
  HELD
  BOOKED
  PAID
  OCCUPIED
  BLOCKED
  UNAVAILABLE
}

enum BookingStatus {
  DRAFT
  HOLD
  CONFIRMED
  PAYMENT_PENDING
  PAID
  COMPLETED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_DRIVER
  CANCELLED_BY_ADMIN
  EXPIRED
}

model User {
  id              String     @id @default(cuid())
  telegramId      BigInt?    @unique
  username        String?
  displayName     String?
  firstName       String?
  lastName        String?
  phone           String?
  avatarUrl       String?
  locale          String     @default("ru")
  theme           UserTheme  @default(TELEGRAM)
  timezone        String     @default("Asia/Tashkent")
  status          UserStatus @default(ACTIVE)
  lastSeenAt      DateTime?
  acceptedTermsAt DateTime?
  termsVersion    String?
  privacyVersion  String?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  roles                                   UserRole[]
  sessions                                AuthSession[]
  acceptances                             UserLegalAcceptance[]
  telegramIdentity                        TelegramIdentity?
  preferences                             UserPreference?
  clientProfile                           ClientProfile?
  driver                                  DriverProfile?
  createdDriverVerificationApplications   DriverVerificationApplication[] @relation("DriverVerificationCreatedBy")
  submittedDriverVerificationApplications DriverVerificationApplication[] @relation("DriverVerificationSubmittedBy")
  reviewedDriverVerificationApplications  DriverVerificationApplication[] @relation("DriverVerificationReviewedBy")
  driverVerificationReviews               DriverVerificationReview[]
  vehicleModerationReviews                VehicleModerationReview[]
  searchEvents                            SearchEvent[]

  @@index([status])
  @@index([phone])
  @@index([createdAt])
}

model Role {
  id          String           @id @default(cuid())
  code        String           @unique
  name        String
  createdAt   DateTime         @default(now())
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  roles     RolePermission[]
  createdAt DateTime         @default(now())
}

model UserRole {
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model TelegramIdentity {
  id                  String   @id @default(cuid())
  userId              String   @unique
  telegramUserId      BigInt   @unique
  username            String?
  firstName           String?
  lastName            String?
  languageCode        String?
  isPremium           Boolean  @default(false)
  photoUrl            String?
  allowsWriteToPm     Boolean?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  lastAuthenticatedAt DateTime @default(now())
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

model UserPreference {
  id                   String    @id @default(cuid())
  userId               String    @unique
  locale               String    @default("ru")
  theme                UserTheme @default(TELEGRAM)
  notificationsEnabled Boolean   @default(true)
  marketingEnabled     Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuthSession {
  id               String     @id @default(cuid())
  userId           String
  appContext       AppContext
  refreshTokenHash String     @unique
  sessionFamilyId  String
  userAgent        String?
  ipHash           String?
  createdAt        DateTime   @default(now())
  lastUsedAt       DateTime   @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokeReason     String?
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([sessionFamilyId])
  @@index([expiresAt])
}

model LegalDocument {
  id             String   @id @default(cuid())
  type           String
  version        String
  locale         String
  title          String
  requiresReview Boolean  @default(true)
  createdAt      DateTime @default(now())

  acceptances UserLegalAcceptance[]

  @@unique([type, version, locale])
}

model UserLegalAcceptance {
  id              String        @id @default(cuid())
  userId          String
  legalDocumentId String
  acceptedAt      DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument   LegalDocument @relation(fields: [legalDocumentId], references: [id])

  @@unique([userId, legalDocumentId])
}

model IdempotencyRecord {
  id           String   @id @default(cuid())
  scope        String
  key          String
  requestHash  String
  responseJson Json?
  status       String
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@unique([scope, key])
}

model AuditEvent {
  id           String   @id @default(cuid())
  actorUserId  String?
  action       String
  entityType   String
  entityId     String
  oldValueJson Json?
  newValueJson Json?
  reason       String?
  requestId    String?
  createdAt    DateTime @default(now())
}

model TimelineEvent {
  id         String   @id @default(cuid())
  scopeType  String
  scopeId    String
  eventType  String
  payload    Json
  occurredAt DateTime @default(now())

  @@index([scopeType, scopeId, occurredAt])
}

model OutboxEvent {
  id          String    @id @default(cuid())
  type        String
  payload     Json
  status      String    @default("PENDING")
  availableAt DateTime  @default(now())
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([status, availableAt, createdAt])
}

model FileObject {
  id                          String                       @id @default(cuid())
  bucket                      String
  key                         String                       @unique
  contentType                 String
  sizeBytes                   Int
  scanStatus                  String                       @default("PENDING")
  createdAt                   DateTime                     @default(now())
  attachments                 FileAttachment[]
  driverVerificationDocuments DriverVerificationDocument[]
  vehicleDocuments            VehicleDocument[]
  vehiclePhotos               VehiclePhoto[]
}

model FileAttachment {
  id         String     @id @default(cuid())
  fileId     String
  entityType String
  entityId   String
  createdAt  DateTime   @default(now())
  file       FileObject @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([entityType, entityId])
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model FeatureFlag {
  key       String   @id
  enabled   Boolean  @default(false)
  payload   Json?
  updatedAt DateTime @updatedAt
}

model DriverProfile {
  id                       String                          @id @default(cuid())
  userId                   String                          @unique
  onboardingStatus         DriverOnboardingStatus          @default(NOT_STARTED)
  verificationStatus       DriverVerificationStatus        @default(NOT_SUBMITTED)
  currentApplicationId     String?                         @unique
  verifiedAt               DateTime?
  suspendedAt              DateTime?
  suspensionReason         String?
  bio                      String?
  city                     String?
  reliabilityScore         Int                             @default(0)
  createdAt                DateTime                        @default(now())
  updatedAt                DateTime                        @updatedAt
  user                     User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentApplication       DriverVerificationApplication?  @relation("CurrentDriverVerificationApplication", fields: [currentApplicationId], references: [id])
  verificationApplications DriverVerificationApplication[] @relation("DriverVerificationApplications")
  vehicles                 Vehicle[]
  trips                    Trip[]
}

model Region {
  id          String   @id @default(cuid())
  countryCode String
  code        String   @unique
  name        String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  cities      City[]

  @@index([countryCode, isActive, sortOrder])
}

model City {
  id           String        @id @default(cuid())
  regionId     String
  code         String        @unique
  nameRu       String
  nameUz       String
  nameKaa      String
  timezone     String        @default("Asia/Tashkent")
  latitude     Decimal?      @db.Decimal(9, 6)
  longitude    Decimal?      @db.Decimal(9, 6)
  isActive     Boolean       @default(true)
  isLaunchCity Boolean       @default(false)
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  pickupPoints PickupPoint[]
  originRoutes Route[]       @relation("OriginCityRoutes")
  destinationRoutes Route[]  @relation("DestinationCityRoutes")
  originTrips             Trip[]        @relation("OriginCityTrips")
  destinationTrips        Trip[]        @relation("DestinationCityTrips")
  originSearchEvents      SearchEvent[] @relation("OriginCitySearchEvents")
  destinationSearchEvents SearchEvent[] @relation("DestinationCitySearchEvents")
  routeStops              RouteStop[]
  tripStops               TripStop[]

  @@index([regionId, isActive, sortOrder])
  @@index([isLaunchCity, isActive, sortOrder])
}

model PickupPoint {
  id        String          @id @default(cuid())
  cityId    String
  name      String
  address   String?
  latitude  Decimal?        @db.Decimal(9, 6)
  longitude Decimal?        @db.Decimal(9, 6)
  type      PickupPointType @default(CUSTOM)
  isActive  Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  city      City            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  tripStops TripStop[]

  @@unique([cityId, name])
  @@index([cityId, isActive, sortOrder])
}

model Route {
  id                       String      @id @default(cuid())
  originCityId             String
  destinationCityId        String
  distanceKm               Int?
  estimatedDurationMinutes Int?
  isActive                 Boolean     @default(true)
  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt
  originCity               City        @relation("OriginCityRoutes", fields: [originCityId], references: [id], onDelete: Restrict)
  destinationCity          City        @relation("DestinationCityRoutes", fields: [destinationCityId], references: [id], onDelete: Restrict)
  stops                    RouteStop[]
  trips                    Trip[]

  @@unique([originCityId, destinationCityId])
  @@index([isActive])
}

model RouteStop {
  id            String       @id @default(cuid())
  routeId       String
  cityId        String
  order         Int
  label         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  route         Route        @relation(fields: [routeId], references: [id], onDelete: Cascade)
  city          City         @relation(fields: [cityId], references: [id], onDelete: Restrict)

  @@unique([routeId, order])
  @@index([cityId])
}

model DriverVerificationApplication {
  id                           String                              @id @default(cuid())
  driverProfileId              String
  version                      Int                                 @default(1)
  status                       DriverVerificationApplicationStatus @default(DRAFT)
  submittedAt                  DateTime?
  reviewStartedAt              DateTime?
  reviewedAt                   DateTime?
  approvedAt                   DateTime?
  rejectedAt                   DateTime?
  changesRequestedAt           DateTime?
  createdAt                    DateTime                            @default(now())
  updatedAt                    DateTime                            @updatedAt
  createdByUserId              String
  lastSubmittedByUserId        String?
  reviewedByUserId             String?
  legalFirstName               String?
  legalLastName                String?
  legalMiddleName              String?
  birthDate                    DateTime?
  gender                       String?
  citizenship                  String?
  personalIdentificationNumber String?
  registeredAddress            String?
  residentialAddress           String?
  phone                        String?
  emergencyContactName         String?
  emergencyContactPhone        String?
  driverLicenseNumber          String?
  driverLicenseIssuedAt        DateTime?
  driverLicenseExpiresAt       DateTime?
  driverLicenseCategory        String?
  driverExperienceSince        DateTime?
  vehicleMake                  String?
  vehicleModel                 String?
  vehicleYear                  Int?
  vehicleColor                 String?
  vehiclePlateNumber           String?
  vehicleRegistrationNumber    String?
  vehicleSeats                 Int?
  consentAcceptedAt            DateTime?
  consentVersion               String?
  privacyVersion               String?
  verificationPolicyVersion    String?
  duplicateWarning             Boolean                             @default(false)
  duplicateReason              String?
  driverProfile                DriverProfile                       @relation("DriverVerificationApplications", fields: [driverProfileId], references: [id])
  currentForDriverProfile      DriverProfile?                      @relation("CurrentDriverVerificationApplication")
  createdByUser                User                                @relation("DriverVerificationCreatedBy", fields: [createdByUserId], references: [id])
  lastSubmittedByUser          User?                               @relation("DriverVerificationSubmittedBy", fields: [lastSubmittedByUserId], references: [id])
  reviewedByUser               User?                               @relation("DriverVerificationReviewedBy", fields: [reviewedByUserId], references: [id])
  documents                    DriverVerificationDocument[]
  reviews                      DriverVerificationReview[]
  events                       DriverVerificationEvent[]

  @@unique([driverProfileId, version])
  @@index([status, submittedAt])
  @@index([reviewedByUserId])
  @@index([duplicateWarning])
  @@index([phone])
  @@index([driverLicenseNumber])
  @@index([vehiclePlateNumber])
}

model DriverVerificationDocument {
  id               String                           @id @default(cuid())
  applicationId    String
  type             DriverVerificationDocumentType
  storageKey       String
  fileObjectId     String?
  originalFileName String
  mimeType         String
  size             Int
  checksum         String
  status           DriverVerificationDocumentStatus @default(UPLOADED)
  uploadedAt       DateTime                         @default(now())
  verifiedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime                         @default(now())
  updatedAt        DateTime                         @updatedAt
  application      DriverVerificationApplication    @relation(fields: [applicationId], references: [id])
  fileObject       FileObject?                      @relation(fields: [fileObjectId], references: [id])

  @@index([applicationId, type, status])
  @@index([storageKey])
}

model DriverVerificationReview {
  id             String                         @id @default(cuid())
  applicationId  String
  reviewerUserId String
  action         DriverVerificationReviewAction
  reasonCode     DriverVerificationReasonCode?
  comment        String?
  metadata       Json?
  createdAt      DateTime                       @default(now())
  application    DriverVerificationApplication  @relation(fields: [applicationId], references: [id])
  reviewer       User                           @relation(fields: [reviewerUserId], references: [id])

  @@index([applicationId, createdAt])
  @@index([reviewerUserId])
}

model DriverVerificationEvent {
  id            String                        @id @default(cuid())
  applicationId String
  actorUserId   String?
  type          String
  payload       Json?
  createdAt     DateTime                      @default(now())
  application   DriverVerificationApplication @relation(fields: [applicationId], references: [id])

  @@index([applicationId, createdAt])
  @@index([type, createdAt])
}

model ClientProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  city                  String?
  emergencyContactName  String?
  emergencyContactPhone String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Vehicle {
  id                 String                      @id @default(cuid())
  driverProfileId    String
  make               String
  model              String
  year               Int?
  color              String?
  plateNumber        String
  normalizedPlate    String
  bodyType           String?
  passengerSeatCount Int                         @default(4)
  passengerSeats     Int                         @default(4)
  luggageCapacity    String?
  amenities          Json?
  isPrimary          Boolean                     @default(false)
  status             VehicleStatus               @default(DRAFT)
  moderationStatus   String                      @default("DRAFT")
  submittedAt        DateTime?
  reviewStartedAt    DateTime?
  reviewedAt         DateTime?
  approvedAt         DateTime?
  rejectedAt         DateTime?
  changesRequestedAt DateTime?
  suspendedAt        DateTime?
  archivedAt         DateTime?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  version            Int                         @default(1)
  driverProfile      DriverProfile               @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  documents          VehicleDocument[]
  photos             VehiclePhoto[]
  reviews            VehicleModerationReview[]
  events             VehicleModerationEvent[]
  trips              Trip[]

  @@index([driverProfileId, status])
  @@index([status, submittedAt])
  @@index([normalizedPlate])
  @@index([isPrimary])
}

model VehicleDocument {
  id               String              @id @default(cuid())
  vehicleId        String
  type             VehicleDocumentType
  storageKey       String
  fileObjectId     String?
  originalFileName String
  mimeType         String
  size             Int
  checksum         String
  status           VehicleAssetStatus  @default(UPLOADED)
  uploadedAt       DateTime            @default(now())
  verifiedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  vehicle          Vehicle             @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  fileObject       FileObject?         @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([vehicleId, type, status])
  @@index([storageKey])
}

model VehiclePhoto {
  id               String             @id @default(cuid())
  vehicleId        String
  type             VehiclePhotoType
  storageKey       String
  fileObjectId     String?
  originalFileName String
  mimeType         String
  size             Int
  checksum         String
  status           VehicleAssetStatus @default(UPLOADED)
  uploadedAt       DateTime           @default(now())
  verifiedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  vehicle          Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  fileObject       FileObject?        @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([vehicleId, type, status])
  @@index([storageKey])
}

model VehicleModerationReview {
  id             String                      @id @default(cuid())
  vehicleId      String
  reviewerUserId String
  action         VehicleModerationAction
  reasonCode     VehicleModerationReasonCode?
  comment        String?
  metadata       Json?
  createdAt      DateTime                    @default(now())
  vehicle        Vehicle                     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  reviewer       User                        @relation(fields: [reviewerUserId], references: [id])

  @@index([vehicleId, createdAt])
  @@index([reviewerUserId])
}

model VehicleModerationEvent {
  id          String   @id @default(cuid())
  vehicleId   String
  actorUserId String?
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Restrict)

  @@index([vehicleId, createdAt])
  @@index([type, createdAt])
}

model Trip {
  id                            String                  @id @default(cuid())
  driverProfileId               String
  vehicleId                     String
  routeId                       String?
  originCityId                  String?
  destinationCityId             String?
  originCity                    String
  destinationCity               String
  departureAtUtc                DateTime
  arrivalEstimateAtUtc          DateTime?
  timezone                      String                  @default("Asia/Tashkent")
  status                        TripStatus              @default(DRAFT)
  passengerSeatCapacity         Int                     @default(1)
  availableSeatCount            Int                     @default(1)
  pricePerSeatMinor             BigInt                  @default(0)
  wholeCarPriceMinor            BigInt?
  parcelSupported               Boolean                 @default(false)
  parcelPriceMinor              BigInt?
  currency                      String                  @default("UZS")
  luggageRules                  String?
  comment                       String?
  publicationValidationSnapshot Json?
  publishedAt                   DateTime?
  unpublishedAt                 DateTime?
  cancelledAt                   DateTime?
  cancellationReason            String?
  blockedAt                     DateTime?
  blockReason                   String?
  createdAt                     DateTime                @default(now())
  updatedAt                     DateTime                @updatedAt
  version                       Int                     @default(1)
  driverProfile                 DriverProfile           @relation(fields: [driverProfileId], references: [id])
  vehicle                       Vehicle                 @relation(fields: [vehicleId], references: [id])
  route                         Route?                  @relation(fields: [routeId], references: [id], onDelete: Restrict)
  origin                        City?                   @relation("OriginCityTrips", fields: [originCityId], references: [id], onDelete: Restrict)
  destination                   City?                   @relation("DestinationCityTrips", fields: [destinationCityId], references: [id], onDelete: Restrict)
  stops                         TripStop[]
  seatSnapshot                  TripSeatSnapshot?
  moderationEvents              TripModerationEvent[]
  timelineEvents                TripTimelineEvent[]
  execution                     TripExecution?
  seats                         TripSeat[]
  bookings                      Booking[]
  searchEvents                  SearchEvent[]

  @@index([driverProfileId, status, departureAtUtc])
  @@index([vehicleId, status, departureAtUtc])
  @@index([originCityId, destinationCityId, departureAtUtc])
  @@index([status, departureAtUtc])
  @@index([routeId])
}

model SearchEvent {
  id                  String   @id @default(cuid())
  sessionId           String?
  userId              String?
  originCityId        String?
  destinationCityId   String?
  tripId              String?
  queryDate           DateTime?
  passengers          Int      @default(1)
  sort                String?
  filtersJson         Json?
  resultCount         Int      @default(0)
  selectedResultRank  Int?
  type                String   @default("SEARCH_PERFORMED")
  createdAt           DateTime @default(now())
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  originCity          City?    @relation("OriginCitySearchEvents", fields: [originCityId], references: [id], onDelete: SetNull)
  destinationCity     City?    @relation("DestinationCitySearchEvents", fields: [destinationCityId], references: [id], onDelete: SetNull)
  trip                Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([originCityId, destinationCityId, createdAt])
  @@index([tripId, createdAt])
  @@index([userId, createdAt])
}

model TripStop {
  id            String       @id @default(cuid())
  tripId        String
  cityId        String
  pickupPointId String?
  order         Int
  type          TripStopType
  plannedAtUtc  DateTime?
  label         String?
  address       String?
  latitude      Decimal?     @db.Decimal(9, 6)
  longitude     Decimal?     @db.Decimal(9, 6)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  trip          Trip         @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City         @relation(fields: [cityId], references: [id], onDelete: Restrict)
  pickupPoint   PickupPoint? @relation(fields: [pickupPointId], references: [id], onDelete: SetNull)

  @@unique([tripId, order])
  @@index([cityId])
  @@index([pickupPointId])
}

model TripSeatSnapshot {
  id                    String   @id @default(cuid())
  tripId                String   @unique
  vehicleId             String
  passengerSeatCapacity Int
  availableSeatCount    Int
  seatLabels            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  trip                  Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripModerationEvent {
  id          String   @id @default(cuid())
  tripId      String
  actorUserId String?
  action      String
  reason      String?
  metadata    Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([action, createdAt])
}

model TripTimelineEvent {
  id        String   @id @default(cuid())
  tripId    String
  type      String
  payload   Json?
  createdAt DateTime @default(now())
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, createdAt])
  @@index([type, createdAt])
}

model TripExecution {
  id        String    @id @default(cuid())
  tripId    String    @unique
  status    String    @default("NOT_STARTED")
  startedAt DateTime?
  endedAt   DateTime?
  trip      Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
}

model TripSeat {
  id      String     @id @default(cuid())
  tripId  String
  seatKey String
  label   String
  status  SeatStatus @default(AVAILABLE)
  trip    Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatKey])
}

model Booking {
  id         String        @id @default(cuid())
  tripId     String
  clientId   String?
  status     BookingStatus @default(DRAFT)
  totalMinor BigInt        @default(0)
  currency   String        @default("UZS")
  createdAt  DateTime      @default(now())
  trip       Trip          @relation(fields: [tripId], references: [id])
  holds      SeatHold[]
}

model SeatHold {
  id        String         @id @default(cuid())
  bookingId String
  expiresAt DateTime
  status    String         @default("ACTIVE")
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  items     SeatHoldItem[]
}

model SeatHoldItem {
  id         String   @id @default(cuid())
  seatHoldId String
  seatKey    String
  seatHold   SeatHold @relation(fields: [seatHoldId], references: [id], onDelete: Cascade)
}
