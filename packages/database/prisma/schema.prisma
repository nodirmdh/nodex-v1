  seats                         TripSeat[]
  bookings                      Booking[]
  seatHolds                     SeatHold[]
  searchEvents                  SearchEvent[]
  operationEvents               TripOperationEvent[]
  statusTransitions             TripStatusTransition[]
  cancellations                 TripCancellation[]
  completionSummary             TripCompletionSummary?
  noShowRecords                 NoShowRecord[]
  parcelOrders                  ParcelOrder[]
  conversations                 Conversation[]
  supportTickets                SupportTicket[]

  @@index([driverProfileId, status, departureAtUtc])
  @@index([vehicleId, status, departureAtUtc])
  @@index([originCityId, destinationCityId, departureAtUtc])
  @@index([status, departureAtUtc])
  @@index([routeId])
}

model SearchEvent {
  id                 String    @id @default(cuid())
