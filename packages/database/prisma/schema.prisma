  updatedAt                     DateTime               @updatedAt
  version                       Int                    @default(1)
  driverProfile                 DriverProfile          @relation(fields: [driverProfileId], references: [id])
  vehicle                       Vehicle                @relation(fields: [vehicleId], references: [id])
