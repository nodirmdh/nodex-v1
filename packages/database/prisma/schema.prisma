  qualifyingTripCount   Int                       @default(0)
  status                String                    @default("IN_PROGRESS")
  reachedAt             DateTime?
  rewardTransactionId   String?                   @unique
  updatedAt             DateTime                  @updatedAt
  createdAt             DateTime                  @default(now())
  driverProfile         DriverProfile             @relation(fields: [driverProfileId], references: [id], onDelete: Cascade)
  milestoneDefinition   RewardMilestoneDefinition @relation(fields: [milestoneDefinitionId], references: [id], onDelete: Cascade)
  rewardTransaction     RewardTransaction?        @relation(fields: [rewardTransactionId], references: [id], onDelete: SetNull)

  @@unique([driverProfileId, milestoneDefinitionId])
  @@index([driverProfileId, status])
}

model TripStartPin {
  id            String    @id @default(cuid())
  tripId        String
  bookingId     String
  codeHash      String
  codeLength    Int       @default(4)
  status        String    @default("ACTIVE")
  expiresAt     DateTime
  attemptsCount Int       @default(0)
  maxAttempts   Int       @default(5)
  lockedAt      DateTime?
  verifiedAt    DateTime?
  verifiedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  trip          Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tripId, status, expiresAt])
  @@index([bookingId, status, expiresAt])
  @@index([verifiedById, verifiedAt])
}

model TripLocationPoint {
  id                   String   @id @default(cuid())
  tripId               String
  bookingId            String?
  actorType            String
  actorUserId          String?
  latitude             Decimal  @db.Decimal(9, 6)
  longitude            Decimal  @db.Decimal(9, 6)
  accuracyMeters       Decimal? @db.Decimal(8, 2)
  speedMetersPerSecond Decimal? @db.Decimal(8, 2)
  headingDegrees       Decimal? @db.Decimal(6, 2)
  source               String
  reason               String?
  recordedAt           DateTime
  metadata             Json?
  createdAt            DateTime @default(now())
  trip                 Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking              Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@index([tripId, recordedAt])
  @@index([bookingId, recordedAt])
  @@index([actorUserId, actorType, recordedAt])
  @@index([source, recordedAt])
}

model TripEtaSnapshot {
  id                        String   @id @default(cuid())
  tripId                    String   @unique
  driverEtaToPickupSeconds  Int?
  driverEtaToDropoffSeconds Int?
  delaySeconds              Int?
  status                    String   @default("UNKNOWN")
  source                    String   @default("MANUAL_MAPS_ADAPTER")
  metadata                  Json?
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  trip                      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model TripOperationEvent {
  id          String   @id @default(cuid())
  tripId      String
  actorUserId String?
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?    @relation("TripOperationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([type, createdAt])
}

model TripStatusTransition {
  id          String     @id @default(cuid())
  tripId      String
  actorUserId String?
  fromStatus  TripStatus
  toStatus    TripStatus
  reason      String?
  metadata    Json?
  createdAt   DateTime   @default(now())
  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?      @relation("TripStatusTransitionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([toStatus, createdAt])
}

model BookingOperationEvent {
  id          String   @id @default(cuid())
  bookingId   String
  actorUserId String?
  type        String
  payload     Json?
  createdAt   DateTime @default(now())
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?    @relation("BookingOperationEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model NoShowRecord {
  id          String   @id @default(cuid())
  tripId      String
  bookingId   String?
  actorUserId String?
  actorRole   String
  type        String
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  actor       User?    @relation("NoShowRecordActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
  @@index([bookingId, createdAt])
  @@index([type, createdAt])
}

model TripCancellation {
  id          String   @id @default(cuid())
  tripId      String
  actorUserId String?
  actorRole   String
  reason      String
  metadata    Json?
  createdAt   DateTime @default(now())
  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor       User?    @relation("TripCancellationActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId, createdAt])
}

model TripCompletionSummary {
  id                 String   @id @default(cuid())
  tripId             String   @unique
  completedByUserId  String?
  completedAt        DateTime @default(now())
  boardedCount       Int      @default(0)
  noShowClientCount  Int      @default(0)
  cancelledCount     Int      @default(0)
  totalBookingsCount Int      @default(0)
  notes              String?
  trip               Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  completedBy        User?    @relation("TripCompletionSummaryActor", fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([completedAt])
}
