  createdAt        DateTime    @default(now())
  message          ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileObject       FileObject? @relation(fields: [fileObjectId], references: [id], onDelete: SetNull)

  @@index([messageId])
  @@index([fileObjectId])
}

