{
  "name": "nodex-intercity",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.13.1 <25",
    "pnpm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:unit": "turbo test:unit",
    "test:integration": "turbo test:integration",
    "test:e2e": "node scripts/run-playwright.mjs",
    "test:e2e:smoke": "node scripts/run-playwright.mjs tests/e2e/foundation.spec.ts --project=desktop",
    "test:a11y": "node scripts/run-playwright.mjs tests/e2e/accessibility.spec.ts",
    "screenshots": "node scripts/run-playwright.mjs tests/e2e/screenshots.spec.ts",
    "storybook": "pnpm --filter @nodex/ui storybook",
    "storybook:build": "pnpm --filter @nodex/ui storybook:build",
    "format": "prettier --write .",
    "format:check": "node scripts/format-check.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm storybook:build",
    "analyze": "pnpm analyze:client && pnpm analyze:driver && pnpm analyze:admin",
    "analyze:client": "pnpm --filter @nodex/client-mini-app analyze",
    "analyze:driver": "pnpm --filter @nodex/driver-mini-app analyze",
    "analyze:admin": "pnpm --filter @nodex/admin-web analyze",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @nodex/database db:generate",
    "db:migrate": "pnpm --filter @nodex/database db:migrate",
    "db:deploy": "pnpm --filter @nodex/database db:deploy",
    "db:seed": "pnpm --filter @nodex/database db:seed",
    "db:reset": "pnpm --filter @nodex/database db:reset",
    "db:backup": "node scripts/backup-postgres.mjs",
    "db:restore": "node scripts/restore-postgres.mjs",
    "acceptance:reset": "cross-env ACCEPTANCE_MODE=true NODE_ENV=development DATABASE_URL=postgresql://nodex:nodex@localhost:15432/nodex?schema=public pnpm --filter @nodex/database acceptance:reset",
    "acceptance:seed": "cross-env ACCEPTANCE_MODE=true NODE_ENV=development DATABASE_URL=postgresql://nodex:nodex@localhost:15432/nodex?schema=public pnpm --filter @nodex/database acceptance:seed",
    "acceptance:scenario": "cross-env ACCEPTANCE_MODE=true NODE_ENV=development DATABASE_URL=postgresql://nodex:nodex@localhost:15432/nodex?schema=public pnpm --filter @nodex/database acceptance:scenario",
    "api:generate": "pnpm --filter @nodex/api-client generate",
    "audit:all": "pnpm audit --audit-level high",
    "audit:production": "pnpm audit --prod --audit-level high",
    "audit:dependencies": "pnpm audit",
    "licenses:check": "pnpm dlx license-checker-rseidelsohn --production --summary"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.2",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.64.0",
    "@typescript-eslint/parser": "8.64.0",
    "cross-env": "^10.1.0",
    "eslint": "9.39.1",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "27.2.0",
    "msw": "2.15.0",
    "orval": "8.23.0",
    "postcss": "8.5.6",
    "prettier": "3.7.4",
    "prisma": "6.19.3",
    "storybook": "10.5.5",
    "turbo": "2.10.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
