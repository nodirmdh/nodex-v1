{
  "name": "@nodex/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.3",
    "@nestjs/terminus": "11.0.0",
    "@nestjs/throttler": "6.4.0",
    "@nodex/auth": "workspace:*",
    "@nodex/config": "workspace:*",
    "@nodex/contracts": "workspace:*",
    "@nodex/database": "workspace:*",
    "@nodex/logger": "workspace:*",
    "@nodex/validation": "workspace:*",
    "express": "5.2.1",
    "helmet": "8.1.0",
    "nestjs-pino": "4.6.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@nodex/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "supertest": "7.1.4",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
