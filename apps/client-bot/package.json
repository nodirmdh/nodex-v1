  "dependencies": {
    "@nodex/telegram": "workspace:*",
    "tsx": "4.21.0"
  },
  "devDependencies": {
    "@nodex/typescript-config": "workspace:*",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
